-- UI-only factory. Load the library first, then call this factory with Luma.
return function(Luma: any): any
    local W=Luma:CreateWindow({Title="Luma UI Lib",ConfigId="luma-demo",Theme="Dark"})
    local group=W:Group("Demo")
    local tab=group:Tab({Name="Components",Icon="folder"})
    local controls=tab:Section({Name="Basic controls",Side="Left"})
    local toggle=controls:Toggle({Name="Test toggle",Flag="demo_toggle",Default=false,Keybind={Key="F2",Mode="Toggle"},Tooltip="Test toggle"})
    controls:Slider({Name="Test slider",Flag="demo_slider",Min=0,Max=100,Step=1,Default=25})
    controls:Input({Name="Test input",Flag="demo_input",Default="",Placeholder="Enter text"})
    controls:Dropdown({Name="Test dropdown",Flag="demo_dropdown",Values={"First","Second","Third"},Default="First"})
    controls:ColorPicker({Name="Test color",Flag="demo_color",Default=Color3.fromRGB(94,159,232)})
    controls:Keybind({Name="Test keybind",Flag="demo_key",Default="F1",Callback=function()W:Notify({Title="Luma",Content="Test keybind",Duration=2})end})
    controls:Segmented({Name="Theme",Flag="demo_segment",Values={"Dark","Light"},Default="Dark",Callback=function(v: string)W:SetTheme(v)end})
    local info=tab:Section({Name="Information",Side="Left"})
    info:Info({Name="Library",Value="Luma UI Lib"})
    info:Info({Name="Made By",Value="x089"})
    info:Label("UI only")
    local actions=tab:Section({Name="Actions",Side="Right"})
    actions:Button({Name="Test notification",Callback=function()W:Notify({Title="Luma",Content="This notification closes automatically.",Duration=3})end})
    actions:Button({Name="Test dialog",Callback=function()W:Dialog({Title="Luma",Content="No gameplay actions are included."})end})
    actions:Button({Name="Test prompt",Callback=function()W:Prompt({Title="Test prompt",Placeholder="Enter text",Callback=function(text: string)W:Notify({Title="Luma",Content=text})end})end})
    local progress=tab:Section({Name="Progress",Side="Right"})
    progress:Progress({Name="Progress",Value=50,Max=100})
    local log=tab:Section({Name="Console",Side="Right"}):Console({Name="Console",Content="Luma UI Lib",NoSave=true})
    toggle:OnChanged(function()log:Append("Luma: "..W:Translate("Test toggle"))end)
    local pages=group:Tab({Name="Pages",Icon="folder"}):Section("Pages","Left")
    pages:Page("First"):Paragraph({Name="Information",Content="No gameplay actions are included."})
    pages:Page("Second"):Info({Name="Status",Value="Ready"})
    W:SelectTab(tab)
    W:Notify({Title="Luma",Content="has been loaded.",Duration=3})
    return W
end
